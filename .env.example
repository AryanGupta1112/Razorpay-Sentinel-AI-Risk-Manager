# Sentinel environment configuration
# Each AI component uses only the API key in its own section.

# Sentinel chat
SENTINEL_LLM_PROVIDER=groq
SENTINEL_LLM_MODEL=openai/gpt-oss-20b
SENTINEL_API_KEY=

# Signal Scout
AGENT_SIGNAL_SCOUT_PROVIDER=gemini
AGENT_SIGNAL_SCOUT_MODEL=gemini-3.5-flash-lite
AGENT_SIGNAL_SCOUT_API_KEY=

# Merchant Guard
AGENT_MERCHANT_GUARD_PROVIDER=groq
AGENT_MERCHANT_GUARD_MODEL=openai/gpt-oss-20b
AGENT_MERCHANT_GUARD_API_KEY=

# Policy Guard
AGENT_POLICY_GUARD_PROVIDER=openrouter
AGENT_POLICY_GUARD_MODEL=openrouter/auto
AGENT_POLICY_GUARD_API_KEY=

# Queue Ops
AGENT_QUEUE_COORDINATOR_PROVIDER=openrouter
AGENT_QUEUE_COORDINATOR_MODEL=openrouter/auto
AGENT_QUEUE_COORDINATOR_API_KEY=

# OpenRouter application identity
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Sentinel AI Risk Console

# Next.js service connections
DJANGO_AUTH_API_BASE_URL=http://127.0.0.1:8000/api
SENTINEL_REDIS_URL=redis://127.0.0.1:6379/1

# Local Docker database defaults
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change_me_before_running_docker
SENTINEL_DATABASE_URL=postgresql://sentinel:change_me_before_running_docker@127.0.0.1:5432/sentinel
SENTINEL_DATABASE_POOL_MAX=10
SENTINEL_DATABASE_IDLE_MS=30000
SENTINEL_DATABASE_CONNECT_MS=5000

# Django email and authentication
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_FROM=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sentinel <security@your-verified-domain.example>
DJANGO_SECRET_KEY=sentinel-dev-secret-key
DJANGO_AUTH_TOKEN_TTL_HOURS=168
DJANGO_AUTH_CODE_TTL_MINUTES=30
AUTH_REQUIRE_VERIFICATION_FOR_NON_ADMINS=true
AUTH_EXPOSE_CODES=false
